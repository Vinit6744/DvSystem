{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DesignReviewSystemDb;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "FileStorage": {
    "MaxFileSizeBytes": 52428800
  },
  "Ocr": {
    "Enabled": true,
    "MinTextLengthThreshold": 20,
    "TessDataPath": "tessdata",
    "Language": "eng",
    "RenderWidth": 1700,
    "RenderHeight": 2200
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJwtTokens_MustBeAtLeast32CharactersLong!",
    "Issuer": "DesignReview.API",
    "Audience": "DesignReview.Client",
    "ExpirationMinutes": 60
  }
}
