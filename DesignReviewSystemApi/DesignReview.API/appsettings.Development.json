{
  "ConnectionStrings": {
    "DefaultConnection": "data source=localhost;initial catalog=DesignReviewSystemDb;integrated security=True;multipleactiveresultsets=False;Encrypt=False;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "https://localhost:3000", "https://localhost:4200" ]
  },
  "FileStorage": {
    "MaxFileSizeBytes": 52428800
  },
  "Ocr": {
    "Enabled": true,
    "MinTextLengthThreshold": 20,
    "TessDataPath": "tessdata",
    "Language": "eng",
    "RenderWidth": 1700,
    "RenderHeight": 2200
  },
  "JwtSettings": {
    "Secret": "DevSecretKeyForJwt_MustBeAtLeast32CharactersLong!",
    "Issuer": "DesignReview.API",
    "Audience": "DesignReview.Client",
    "ExpirationMinutes": 60
  },
  "SeedAdmin": {
    "UserName": "admin",
    "Email": "admin@designreview.local",
    "Password": "Admin@123"
  },
  "SeedReviewer": {
    "UserName": "reviewer",
    "Email": "reviewer@designreview.local",
    "Password": "Reviewer@123"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

